{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background/worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "js": [
        "src/common/settings.js",
        "src/common/nav.js",
        "src/content/guard.js",
        "src/content/sweep.js"
      ],
      "css": [
        "src/content/hide.css"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shorts",
        "enabled": true,
        "path": "src/rules/shorts.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/pages/blocked.html"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "src/pages/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/pages/popup.html",
    "default_title": "Youtube Focus"
  }
}
